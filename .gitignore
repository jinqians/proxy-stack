# Runtime state (may contain credentials/passwords)
# Ignore the whole directory so a new protocol store cannot accidentally leak
# UUIDs, passwords, tokens, or private keys before .gitignore is updated.
config/

# Backup archives
backup/
*.tar.gz

# Logs
logs/

# Control-plane runtime data and Python bytecode
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Local dev notes, tests, and CI tooling (keep out of the public repo)
docs/
tests/
scripts/ci.sh
.github/
